# Leave empty locally to use persistent embedded PostgreSQL.
# Required for production: PostgreSQL connection string.
DATABASE_URL=
DATABASE_DIR=./data/minassati
APP_ORIGIN=http://localhost:3000
# Enable only behind a proxy that replaces X-Real-IP.
TRUST_PROXY=false
# Enable when served over HTTPS.
COOKIE_SECURE=false
# Required in production: a random secret of at least 32 characters.
RATE_LIMIT_SECRET=
# Used by npm run admin:create. Remove password after account creation.
ADMIN_USERNAME=
ADMIN_PASSWORD=
