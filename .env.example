# postgres for the existing local database; firestore for Firebase.
DATABASE_PROVIDER=postgres
# Used only with DATABASE_PROVIDER=postgres.
DATABASE_URL=
DATABASE_DIR=./data/minassati
APP_ORIGIN=http://localhost:3000
# Enable only behind a proxy that replaces X-Real-IP.
TRUST_PROXY=false
# Enable when served over HTTPS.
COOKIE_SECURE=false
# Required in production: a random secret of at least 32 characters.
RATE_LIMIT_SECRET=
# Used by npm run admin:create. Remove password after account creation.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Firebase server access. Web SDK apiKey is NOT a server credential.
FIREBASE_PROJECT_ID=sgyqkl
# Set ONE credential source, locally or on your hosting server; never NEXT_PUBLIC_.
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
